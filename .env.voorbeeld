# Kopieer dit bestand naar ".env" en vul je eigen sleutels in.
# Een sleutel voor CARTO maak je aan op https://carto.com
CARTO_SLEUTEL=

# Supabase (database + inloggen): Project Settings > API Keys.
# Gebruik de "Project URL" en de "publishable key", NOOIT de secret key.
SUPABASE_URL=
SUPABASE_SLEUTEL=
